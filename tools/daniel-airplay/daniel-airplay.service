[Unit]
Description=AirPlay screen-mirroring receiver (daniel-airplay)
After=network.target

[Service]
# Root: it opens its ports in the nftables input chain (wlan_bridge only).
# The native helpers that parse network data (airplay-video, fairplay) run as nobody.
RuntimeDirectory=daniel-airplay
RuntimeDirectoryMode=0755
ExecStartPre=/bin/mkdir -p /var/opt/daniel-airplay/data
ExecStart=/usr/bin/node /var/opt/daniel-airplay/current/airplayd.js
# The unit's system.conf sends stdout to null by default.
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
